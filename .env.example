# Local development values only. Use unique secrets and TLS settings in deployment.
DATABASE_URL=sqlite:///./data/app.db
DATASET_PATH=./Vibration, Acoustic, Temperature, and Motor Current Dataset of Rotating Machine Under Varying Load Conditions for Fault Diagnosis
ARTIFACT_DIR=./artifacts
REPORT_DIR=./reports
FEATURE_SCHEMA_VERSION=1.0

ADMIN_API_KEY=replace-with-a-long-random-local-key

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_FEATURES_TOPIC=machine/features
MQTT_PREDICTIONS_TOPIC=machine/predictions
MQTT_EVENTS_TOPIC=machine/events

STALE_AFTER_SECONDS=120
SELECTIVE_TARGET_ACCURACY=0.90
SELECTIVE_MINIMUM_ACCEPTED=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
